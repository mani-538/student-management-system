{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Student Management System API",
		"description": "Postman Collection v2.1 for testing all CRUD operations and validation rules of the Student Management System REST API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "studentId",
			"value": "",
			"type": "string"
		},
		{
			"key": "studentEmail",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Create Valid Student",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const timestamp = Date.now();",
							"pm.collectionVariables.set('dynamicEmail', `postman_student_${timestamp}@example.com`);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Response contains valid student object', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData.name).to.eql('Postman Test Student');",
							"    pm.expect(jsonData.course).to.eql('Computer Science');",
							"    pm.expect(jsonData.age).to.eql(20);",
							"    ",
							"    // Save dynamic variables for downstream requests",
							"    pm.collectionVariables.set('studentId', jsonData.id.toString());",
							"    pm.collectionVariables.set('studentEmail', jsonData.email);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Postman Test Student\",\n    \"email\": \"{{dynamicEmail}}\",\n    \"course\": \"Computer Science\",\n    \"age\": 20\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/students/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"students",
						""
					]
				},
				"description": "Creates a new student record with valid payload. Expects 201 Created and saves studentId and studentEmail to collection variables."
			},
			"response": []
		},
		{
			"name": "2. List All Students",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is a JSON array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/students/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"students",
						""
					]
				},
				"description": "Retrieves list of all students. Expects 200 OK and confirms response format is a JSON array."
			},
			"response": []
		},
		{
			"name": "3. Retrieve Created Student",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Returned student ID matches studentId variable', function () {",
							"    const jsonData = pm.response.json();",
							"    const expectedId = parseInt(pm.collectionVariables.get('studentId'), 10);",
							"    pm.expect(jsonData.id).to.eql(expectedId);",
							"    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get('studentEmail'));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/students/{{studentId}}/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"students",
						"{{studentId}}",
						""
					]
				},
				"description": "Fetches a single student using the saved studentId variable. Expects 200 OK and verifies student details."
			},
			"response": []
		},
		{
			"name": "4. Update Student",
			"event": [
				{
					"listen": "test",
