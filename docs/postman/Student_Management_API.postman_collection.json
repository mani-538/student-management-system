							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Postman Test Student Updated');",
							"    pm.expect(jsonData.course).to.eql('Software Engineering');",
							"    pm.expect(jsonData.age).to.eql(23);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Postman Test Student Updated\",\n    \"email\": \"{{studentEmail}}\",\n    \"course\": \"Software Engineering\",\n    \"age\": 23\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/students/{{studentId}}/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"students",
						"{{studentId}}",
						""
					]
				},
				"description": "Completely updates the student record supplying all required fields. Expects 200 OK."
			},
			"response": []
		},
		{
			"name": "5. Partially Update Student",
			"event": [
				{
					"listen": "test",
